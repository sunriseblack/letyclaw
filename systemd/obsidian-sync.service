[Unit]
Description=Optional Obsidian Headless vault sync
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=letyclaw
Group=letyclaw
WorkingDirectory=/home/letyclaw
Environment=HOME=/home/letyclaw
Environment=OBSIDIAN_VAULT_NAME=Letyclaw
Environment=OBSIDIAN_VAULT_PATH=/root/vault
Environment=OBSIDIAN_DEVICE_NAME=letyclaw-server
EnvironmentFile=-/etc/letyclaw-obsidian/env
ExecStart=/usr/bin/ob sync --continuous --vault ${OBSIDIAN_VAULT_NAME} --vault-path ${OBSIDIAN_VAULT_PATH} --device-name ${OBSIDIAN_DEVICE_NAME}
Restart=on-failure
RestartSec=10
UMask=0077
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/root/vault /home/letyclaw

[Install]
WantedBy=multi-user.target
