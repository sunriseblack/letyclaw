[Unit]
Description=Refresh Claude CLI OAuth token for letyclaw user
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=letyclaw
Group=letyclaw
WorkingDirectory=/tmp
UMask=0077
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=CLAUDE_PATH=/usr/bin/claude
Environment=CLAUDE_REFRESH_NODE=/usr/bin/node
Environment=HOME=/tmp
ExecStart=/root/letyclaw/scripts/refresh-claude-token.sh
TimeoutStartSec=100

# Expose only this account's credential store. The letyclaw UID is shared by the
# bot, so UID permissions alone are not an isolation boundary.
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=-/root/letyclaw/scripts/refresh-claude-token.sh -/home/letyclaw/.claude.json
BindPaths=/home/letyclaw/.claude
InaccessiblePaths=-/root/letyclaw/sessions/connector-home
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectClock=true
RestrictSUIDSGID=true
