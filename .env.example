# Required
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather

# AI backend — the main bot uses Claude CLI (requires a Claude subscription).
# Headless/container deployments can provide a setup token.
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...

# Model and effort selection
CLAUDE_MODEL=claude-sonnet-4-6
# CLAUDE_EFFORT=high

# Paths. Runtime fallbacks are server-oriented (/root/vault and
# /root/letyclaw/sessions), so local and container users should set these.
VAULT_PATH=./vault
SESSIONS_DIR=./sessions

# Optional YAML overrides (normally read from config/letyclaw.yaml)
# TELEGRAM_GROUP_ID=-1001234567890
# TELEGRAM_ALLOW_USER=123456789

# Optional: OpenAI for DALL-E image generation and TTS
# OPENAI_API_KEY=sk-...

# Optional: Vapi for AI voice calls
# VAPI_API_KEY=
# VAPI_PHONE_NUMBER_ID=
# VAPI_ASSISTANT_ID=
# VAPI_SERVER_URL=https://bot.example.com/voice/vapi
# VAPI_SERVER_CREDENTIAL_ID=
# VAPI_WEBHOOK_SECRET=

# Optional: authenticated Apple Health webhook / Oura / Withings sync
# HEALTH_WEBHOOK_SECRET=
# OURA_TOKEN=
# WITHINGS_CLIENT_ID=
# WITHINGS_CLIENT_SECRET=

# Optional: TickTick
# TICKTICK_CLIENT_ID=
# TICKTICK_CLIENT_SECRET=

# Optional legacy real-time voice relay (uses the Anthropic API directly)
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: Alpha Vantage for market data
# ALPHA_VANTAGE_API_KEY=

# Optional: Whisper for voice transcription
# WHISPER_MODEL=/path/to/ggml-base.bin
